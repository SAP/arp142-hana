}

_BASHUNIT_ASSERT_JOINED_OUT=""

function bashunit::assert::join_to_slot() {
  local IFS=$'\n'
  local joined="$*"
  while [ "$joined" != "${joined%$'\n'}" ]; do
    joined="${joined%$'\n'}"
  done
