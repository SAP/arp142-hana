function bashunit::main::abort_unknown_option() {
  printf "%sError: unknown option '%s'. Run 'bashunit %s --help' to list the available options.%s\n" \
    "${_BASHUNIT_COLOR_FAILED}" "$1" "$2" "${_BASHUNIT_COLOR_DEFAULT}" >&2
