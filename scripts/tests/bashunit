_BASHUNIT_ASSERT_LABEL_OUT=""

function bashunit::assert::label_to_slot() {
  local custom_label="${1:-}"
  local fallback_depth="${2:-2}"
  if [ -n "$custom_label" ]; then
    _BASHUNIT_ASSERT_LABEL_OUT=$custom_label
