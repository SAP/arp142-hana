#!/usr/bin/env bash

function check_1300_cpu_governor_x64 {

    logTrace "<${BASH_SOURCE[0]}:${FUNCNAME[*]}>"

    local -i _retval=99

    # MODIFICATION SECTION>>

    local -r sapnote='#383075'                     # Requirements on Intel CPU frequency scaling for SAP HANA
    local -r expected_governor='performance'
    # MODIFICATION SECTION<<


    # PRECONDITIONS
    if ! LIB_FUNC_IS_INTEL; then

        logCheckSkipped 'Not running on Intel CPU. Skipping' "<${FUNCNAME[0]}>"
        _retval=3

    elif ! LIB_FUNC_IS_BARE_METAL ; then

        logCheckSkipped 'Running virtualized. Skipping' "<${FUNCNAME[0]}>"
        _retval=3

    fi

    #CHECK
    if [[ ${_retval} -eq 99 ]]; then

        local -a govs
        # read unique governors into array (support TEST_govs for unit testing)
        if [[ -n "${TEST_govs[0]:-}" ]]; then
            govs=("${TEST_govs[@]}")
        else
            mapfile -t govs < <(sort -u /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null)
        fi

        case ${#govs[@]} in     #array length

            0)
                        logCheckWarning "CPU governor NOT set (SAP Note  ${sapnote:-})"
                        _retval=1
                ;;

            1)
                        if [[ "${govs[0]}" != "${expected_governor}" ]];then
                            logCheckWarning "CPU governor NOT set as recommended (SAP Note ${sapnote:-}) (is: ${govs[0]}, should be: ${expected_governor})"
                            _retval=1
                        else
                            logCheckOk "CPU governor set as recommended (SAP Note ${sapnote:-}) (is: ${expected_governor})"
                            _retval=0
                        fi

                ;;

            *)      logCheckWarning "CPU governor NOT set as recommended (SAP Note ${sapnote:-}) (is: multiple, should be: ${expected_governor})"
                    _retval=1
                ;;
        esac

    fi

    logDebug "<${BASH_SOURCE[0]}:${FUNCNAME[0]}> # RC=${_retval}"
    return ${_retval}

}
